# Exclude large databases
*.db
*.bak_*
*.xlsx
*.sql
*.py
*.csv
!data_inputV1.csv
!templates/hr_forecast_template.csv
!API/*.py
!API/etl/*.py
!scripts/*.py

# API one-off extraction utilities (keep out of release/PR by default)
API/discover_api_patterns.py
API/extract_general_api.py
API/extract_pp_hdc.py
API/get_cats_api.py
API/scan_all_api_endpoints*.py

# Exclude temporary files
/tmp/
.gemini/
.agents/
.agent/
_agents/
_agent/
node_modules/
.DS_Store

# Python cache / local artifacts
__pycache__/
*.pyc

# OMX runtime state (local only)
.omx/

# Debug artifacts / screenshots (keep computed JSONs explicit if needed)
output/*.png
output/hr_forecast_results.json
output_step*.png
debug_*.json
_tmp_*
tmp_*.json
pp_*_summary.json
pp_shortlist_extract_*.json
progression*.md
deploy/
API/data/
API/**/__pycache__/
output/playwright/
API/debug_hdc_view_state.py
